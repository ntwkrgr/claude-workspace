{
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "permissions": {
    "deny": [
      "EnterPlanMode"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/Developer/claude-workspace/install.sh ] && ~/Developer/claude-workspace/install.sh --pull || true"
          },
          {
            "type": "command",
            "command": "sh ~/.claude/plugins/marketplaces/superpowers-extended-cc-marketplace/hooks/check-onboard-drift"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-env-edits.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/plugins/marketplaces/superpowers-extended-cc-marketplace/hooks/examples/post-task-complete-revalidate.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/plugins/marketplaces/superpowers-extended-cc-marketplace/hooks/examples/stop-revalidate-user-gates.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/plugins/marketplaces/superpowers-extended-cc-marketplace/hooks/examples/stop-wait-guard.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/hooks/statusline.js\""
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "superpowers-extended-cc@superpowers-extended-cc-marketplace": true,
    "swiftui-pro@swiftui-agent-skill": true,
    "frontend-design@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "superpowers-extended-cc-marketplace": {
      "source": {
        "source": "github",
        "repo": "pcvelz/superpowers"
      },
      "autoUpdate": true
    },
    "swiftui-agent-skill": {
      "source": {
        "source": "git",
        "url": "https://github.com/twostraws/SwiftUI-Agent-Skill.git"
      }
    }
  },
  "outputStyle": "Concise",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh",
      "autoCompactWindow": 600000
    }
  },
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "subagentStatusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/hooks/statusline.js\" subagent"
  }
}
